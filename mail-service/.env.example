# --- SMTP ---
# Для разработки: Mailpit (docker-compose) — host=localhost/mailpit, port=1025, без TLS и авторизации.
# Gmail: smtp.gmail.com, 587, STARTTLS=true, пароль приложения. Яндекс: smtp.yandex.ru, 465, SSL_TLS=true.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=no-reply@example.com
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Timescale App
EMAIL_STARTTLS=false
EMAIL_SSL_TLS=false
EMAIL_USE_CREDENTIALS=false
# Необязательно: логотип в шапке писем и ссылка на сайт
LOGO_URL=
APP_URL=http://localhost:5173
