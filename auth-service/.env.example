# --- tokens ---
ACCESS_HEADER_TOKEN_NAME=X-Access-Token
REFRESH_HEADER_TOKEN_NAME=X-Refresh-Token
ACCESS_TOKEN_EXPIRE_SECONDS=1800
REFRESH_TOKEN_EXPIRE_SECONDS=604800
VERIFY_TOKEN_EXPIRE_SECONDS=600
ALGORITHM_ENCRYPTION=HS256
# Общий секрет с timescale-service. В продакшене — длинная случайная строка:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-me-please-at-least-32-bytes

# --- verification codes ---
CODE_EXPIRE_SECONDS=600
CODE_RESEND_SECONDS=60
CODE_MAX_ATTEMPTS=5

# --- database ---
DB_NAME=timescale_db
DB_SCHEMA=auth
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- url ---
MAIL_SERVICE=http://localhost:8002/api/

CORS_ORIGINS=["http://localhost:5173"]
